{%- assign featured_blog = blogs[section.settings.blog] -%}

<div class="blog-teaser">
  <div class="blog-teaser__header">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a class="blog-teaser__all" href="{{ section.settings.cta_url | default: featured_blog.url | default: '/blogs' }}">
        {{- section.settings.cta_label | escape -}}
      </a>
    {%- endif -%}
  </div>

  {%- if featured_blog != blank and featured_blog.articles_count > 0 -%}
    <ul class="blog-teaser__grid" role="list">
      {%- for article in featured_blog.articles limit: section.settings.articles_count -%}
        <li class="blog-teaser__item">
          <a class="blog-teaser__link" href="{{ article.url }}">
            {%- if section.settings.show_image and article.image != blank -%}
              <div class="blog-teaser__media">
                {{- article.image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    alt: article.image.alt | default: article.title | escape
                -}}
              </div>
            {%- endif -%}
            <div class="blog-teaser__content">
              {%- if section.settings.show_date -%}
                <p class="blog-teaser__date">
                  {{- article.published_at | time_tag: '%d. %B %Y' -}}
                </p>
              {%- endif -%}
              <h3 class="blog-teaser__title">{{ article.title | escape }}</h3>
              {%- if section.settings.show_excerpt and article.excerpt != blank -%}
                <p class="blog-teaser__excerpt">{{ article.excerpt | strip_html | truncate: 120 }}</p>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <p class="blog-teaser__empty">Noch keine Beiträge vorhanden.</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .blog-teaser {
    padding: 4rem 0;
  }

  .blog-teaser__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .blog-teaser__header .section-heading {
    margin-bottom: 0;
  }

  .blog-teaser__all {
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    color: inherit;
    white-space: nowrap;
  }

  .blog-teaser__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .blog-teaser__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .blog-teaser__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 4px;
    margin-bottom: 1rem;
    background-color: #f9f5f0;
  }

  .blog-teaser__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .blog-teaser__link:hover .blog-teaser__media img {
    transform: scale(1.03);
  }

  .blog-teaser__date {
    font-size: 0.8rem;
    opacity: 0.6;
    margin: 0 0 0.5rem;
  }

  .blog-teaser__title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 0.5rem;
  }

  .blog-teaser__link:hover .blog-teaser__title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .blog-teaser__excerpt {
    font-size: 0.875rem;
    line-height: 1.6;
    opacity: 0.75;
    margin: 0;
  }

  .blog-teaser__empty {
    opacity: 0.6;
    text-align: center;
    padding: 2rem 0;
  }

  @media (max-width: 768px) {
    .blog-teaser__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog-Teaser",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Aus unserem Blog"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "articles_count",
      "label": "Anzahl Artikel",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Bild anzeigen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Datum anzeigen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Vorschautext anzeigen",
      "default": true
    },
    {
      "type": "header",
      "content": "Link zum Blog"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link-Text",
      "default": "Alle Beiträge"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link-URL"
    }
  ],
  "presets": [
    {
      "name": "Blog-Teaser",
      "category": "Startseite"
    }
  ]
}
{% endschema %}
