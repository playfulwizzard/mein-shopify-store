{% style %}
  #shopify-section-{{ section.id }} .usp-bar {
    background-color: {{ section.settings.background_color }};
  }
{% endstyle %}

<div class="usp-bar">
  {%- if section.settings.heading != blank -%}
    <h2 class="usp-bar__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <ul class="usp-bar__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="usp-bar__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <div class="usp-bar__icon">
              {%- assign usp_icon_alt = block.settings.title | escape -%}
              {{- block.settings.icon
                | image_url: width: 80
                | image_tag: alt: usp_icon_alt, loading: 'lazy'
              -}}
            </div>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="usp-bar__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="usp-bar__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  .usp-bar {
    padding: 3rem 0;
  }

  .usp-bar__heading {
    text-align: center;
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 2rem;
  }

  .usp-bar__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 2rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .usp-bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
  }

  .usp-bar__icon {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .usp-bar__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .usp-bar__title {
    font-size: 1rem;
    font-weight: 700;
    margin: 0;
  }

  .usp-bar__text {
    font-size: 0.9rem;
    line-height: 1.5;
    opacity: 0.8;
    margin: 0;
  }

  @media (max-width: 768px) {
    .usp-bar__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "USP-Leiste",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "info": "Leer lassen um die Überschrift auszublenden"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe",
      "default": "#f9f5f0"
    }
  ],
  "blocks": [
    {
      "type": "usp_item",
      "name": "USP",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "USP Titel"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Beschreibung",
          "default": "Kurze Beschreibung des Vorteils."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP-Leiste",
      "category": "Startseite",
      "blocks": [
        {
          "type": "usp_item",
          "settings": {
            "title": "100% Bio",
            "text": "Alle unsere Kakao-Produkte sind zertifiziert biologisch angebaut."
          }
        },
        {
          "type": "usp_item",
          "settings": {
            "title": "Fair Trade",
            "text": "Direkte Partnerschaften mit Kakaobauern für faire Löhne."
          }
        },
        {
          "type": "usp_item",
          "settings": {
            "title": "Handverlesen",
            "text": "Jede Bohne wird sorgfältig ausgewählt und verarbeitet."
          }
        },
        {
          "type": "usp_item",
          "settings": {
            "title": "Schneller Versand",
            "text": "Lieferung in 2–3 Werktagen direkt zu dir nach Hause."
          }
        }
      ]
    }
  ]
}
{% endschema %}
