{% style %}
  #shopify-section-{{ section.id }} .image-with-text {
    background-color: {{ section.settings.background_color }};
  }
  #shopify-section-{{ section.id }} .image-with-text__media {
    {%- if section.settings.image_ratio == 'square' -%}
      aspect-ratio: 1 / 1;
    {%- elsif section.settings.image_ratio == 'portrait' -%}
      aspect-ratio: 3 / 4;
    {%- else -%}
      aspect-ratio: 4 / 3;
    {%- endif -%}
  }
  {%- if section.settings.image_position == 'right' -%}
  #shopify-section-{{ section.id }} .image-with-text__media {
    order: 2;
  }
  #shopify-section-{{ section.id }} .image-with-text__content {
    order: 1;
  }
  {%- endif -%}
{% endstyle %}

<div class="image-with-text">
  <div class="image-with-text__inner">
    <div class="image-with-text__media">
      {%- if section.settings.image != blank -%}
        {{- section.settings.image
          | image_url: width: 1000
          | image_tag:
            loading: 'lazy',
            alt: section.settings.image.alt | default: section.settings.heading | escape
        -}}
      {%- else -%}
        <div class="image-with-text__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
      {%- endif -%}
    </div>

    <div class="image-with-text__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="image-with-text__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="image-with-text__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="image-with-text__cta" href="{{ section.settings.cta_url | default: '#' }}">
          {{- section.settings.cta_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .image-with-text {
    padding: 4rem 0;
  }

  .image-with-text__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .image-with-text__media {
    overflow: hidden;
    border-radius: 4px;
  }

  .image-with-text__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .image-with-text__placeholder {
    aspect-ratio: 4 / 3;
    background-color: #f0ebe4;
  }

  .image-with-text__placeholder svg {
    width: 100%;
    height: 100%;
  }

  .image-with-text__heading {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }

  .image-with-text__text {
    font-size: 1rem;
    line-height: 1.7;
    opacity: 0.85;
  }

  .image-with-text__text p + p {
    margin-top: 0.75rem;
  }

  .image-with-text__cta {
    display: inline-block;
    margin-top: 1.75rem;
    padding: 0.75rem 2rem;
    border: 2px solid currentColor;
    text-decoration: none;
    font-weight: 600;
    border-radius: var(--style-border-radius-inputs);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .image-with-text__cta:hover {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  @media (max-width: 768px) {
    .image-with-text__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .image-with-text__media {
      order: 1 !important;
    }

    .image-with-text__content {
      order: 2 !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bild mit Text",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Bildposition",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Bildformat",
      "options": [
        { "value": "landscape", "label": "Querformat (4:3)" },
        { "value": "square", "label": "Quadrat (1:1)" },
        { "value": "portrait", "label": "Hochformat (3:4)" }
      ],
      "default": "landscape"
    },
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Unsere Geschichte"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>La Chocolatera wurde aus einer tiefen Leidenschaft für echten, unverfälschten Kakao geboren. Wir glauben daran, dass guter Kakao nicht nur schmeckt – er erzählt eine Geschichte von Boden, Sonne und Menschen.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button-Text"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button-Link"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Bild mit Text",
      "category": "Startseite"
    }
  ]
}
{% endschema %}
