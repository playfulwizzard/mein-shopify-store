{% style %}
  #shopify-section-{{ section.id }} .collection-grid__grid {
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
  }
{% endstyle %}

<div class="collection-grid">
  {%- if section.settings.heading != blank -%}
    <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <ul class="collection-grid__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign collection = collections[block.settings.collection] -%}
        <li class="collection-grid__item" {{ block.shopify_attributes }}>
          <a class="collection-grid__link" href="{{ collection.url }}">
            <div class="collection-grid__media">
              {%- if collection.featured_image != blank -%}
                {{- collection.featured_image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    alt: collection.featured_image.alt | default: collection.title | escape
                -}}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="collection-grid__overlay" aria-hidden="true"></div>
            <h3 class="collection-grid__title">{{ collection.title | escape }}</h3>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  .collection-grid {
    padding: 4rem 0;
  }

  .collection-grid__grid {
    display: grid;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .collection-grid__item {
    position: relative;
  }

  .collection-grid__link {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    text-decoration: none;
    color: #ffffff;
  }

  .collection-grid__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .collection-grid__media img,
  .collection-grid__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .collection-grid__link:hover .collection-grid__media img {
    transform: scale(1.04);
  }

  .collection-grid__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.1) 60%);
    transition: opacity 0.3s ease;
  }

  .collection-grid__link:hover .collection-grid__overlay {
    opacity: 0.8;
  }

  .collection-grid__title {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    right: 1.25rem;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }

  @media (max-width: 768px) {
    .collection-grid__grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }

  @media (max-width: 480px) {
    .collection-grid__grid {
      grid-template-columns: 1fr !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Kategorie-Grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Unsere Kategorien"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Spalten",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Kategorie",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Kollektion"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kategorie-Grid",
      "category": "Startseite"
    }
  ]
}
{% endschema %}
