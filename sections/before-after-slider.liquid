{% style %}
  #shopify-section-{{ section.id }} .ba-slider__before-label {
    color: {{ section.settings.label_color }};
    background-color: {{ section.settings.label_bg }};
  }
  #shopify-section-{{ section.id }} .ba-slider__after-label {
    color: {{ section.settings.label_color }};
    background-color: {{ section.settings.label_bg }};
  }
  #shopify-section-{{ section.id }} .ba-slider__handle {
    background-color: {{ section.settings.handle_color }};
  }
  #shopify-section-{{ section.id }} .ba-slider__handle-line {
    background-color: {{ section.settings.handle_color }};
  }
  #shopify-section-{{ section.id }} .ba-slider__handle-arrow {
    border-color: {{ section.settings.handle_color }};
    color: {{ section.settings.handle_color }};
  }
  #shopify-section-{{ section.id }} .ba-slider__wrapper {
    {%- if section.settings.image_ratio == 'square' -%}
      aspect-ratio: 1 / 1;
    {%- elsif section.settings.image_ratio == 'portrait' -%}
      aspect-ratio: 3 / 4;
    {%- elsif section.settings.image_ratio == 'wide' -%}
      aspect-ratio: 16 / 9;
    {%- else -%}
      aspect-ratio: 4 / 3;
    {%- endif -%}
  }
{% endstyle %}

<div class="before-after-slider">
  {%- if section.settings.heading != blank -%}
    <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if section.settings.subheading != blank -%}
    <p class="before-after-slider__subheading">{{ section.settings.subheading | escape }}</p>
  {%- endif -%}

  <div
    class="ba-slider__wrapper"
    data-ba-slider
    data-initial="{{ section.settings.initial_position }}"
    aria-label="{{ section.settings.heading | default: 'Vorher-Nachher Vergleich' | escape }}"
  >
    {%- comment -%} Nachher-Bild (hinten, volle Breite) {%- endcomment -%}
    <div class="ba-slider__after">
      {%- if section.settings.image_after != blank -%}
        {{- section.settings.image_after
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            draggable: 'false',
            alt: section.settings.label_after | default: 'Nachher' | escape
        -}}
      {%- else -%}
        <div class="ba-slider__placeholder">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>
      {%- endif -%}
      {%- if section.settings.show_labels -%}
        <span class="ba-slider__after-label ba-slider__label">
          {{- section.settings.label_after | default: 'Nachher' | escape -}}
        </span>
      {%- endif -%}
    </div>

    {%- comment -%} Vorher-Bild (vorne, wird per Clip beschnitten) {%- endcomment -%}
    <div class="ba-slider__before" style="width: {{ section.settings.initial_position }}%;">
      {%- if section.settings.image_before != blank -%}
        {{- section.settings.image_before
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            draggable: 'false',
            alt: section.settings.label_before | default: 'Vorher' | escape
        -}}
      {%- else -%}
        <div class="ba-slider__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
      {%- endif -%}
      {%- if section.settings.show_labels -%}
        <span class="ba-slider__before-label ba-slider__label">
          {{- section.settings.label_before | default: 'Vorher' | escape -}}
        </span>
      {%- endif -%}
    </div>

    {%- comment -%} Slider-Handle {%- endcomment -%}
    <div
      class="ba-slider__handle"
      role="slider"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ section.settings.initial_position }}"
      aria-label="Slider"
      style="left: {{ section.settings.initial_position }}%;"
      tabindex="0"
    >
      <div class="ba-slider__handle-line ba-slider__handle-line--top"></div>
      <div class="ba-slider__handle-circle">
        <svg class="ba-slider__handle-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M8 5l-5 7 5 7M16 5l5 7-5 7" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="ba-slider__handle-line ba-slider__handle-line--bottom"></div>
    </div>
  </div>
</div>

<script>
(function() {
  function initSlider(wrapper) {
    const before = wrapper.querySelector('.ba-slider__before');
    const beforeImg = before.querySelector('img');
    const handle = wrapper.querySelector('.ba-slider__handle');
    let isDragging = false;

    function setPosition(percent) {
      const clamped = Math.min(100, Math.max(0, percent));
      // Clip-Bereich
      before.style.width = clamped + '%';
      // Bild immer auf volle Wrapper-Breite strecken
      if (beforeImg) beforeImg.style.width = wrapper.offsetWidth + 'px';
      handle.style.left = clamped + '%';
      handle.setAttribute('aria-valuenow', Math.round(clamped));
    }

    // Bild-Breite bei Resize aktualisieren
    new ResizeObserver(function() {
      if (beforeImg) beforeImg.style.width = wrapper.offsetWidth + 'px';
    }).observe(wrapper);

    function getPercent(clientX) {
      const rect = wrapper.getBoundingClientRect();
      return ((clientX - rect.left) / rect.width) * 100;
    }

    // Mouse
    handle.addEventListener('mousedown', function(e) {
      e.preventDefault();
      isDragging = true;
    });

    document.addEventListener('mousemove', function(e) {
      if (!isDragging) return;
      setPosition(getPercent(e.clientX));
    });

    document.addEventListener('mouseup', function() {
      isDragging = false;
    });

    // Touch
    handle.addEventListener('touchstart', function(e) {
      isDragging = true;
    }, { passive: true });

    document.addEventListener('touchmove', function(e) {
      if (!isDragging) return;
      setPosition(getPercent(e.touches[0].clientX));
    }, { passive: true });

    document.addEventListener('touchend', function() {
      isDragging = false;
    });

    // Keyboard (Accessibility)
    handle.addEventListener('keydown', function(e) {
      const current = parseFloat(handle.style.left);
      if (e.key === 'ArrowLeft') { e.preventDefault(); setPosition(current - 2); }
      if (e.key === 'ArrowRight') { e.preventDefault(); setPosition(current + 2); }
      if (e.key === 'Home') { e.preventDefault(); setPosition(0); }
      if (e.key === 'End') { e.preventDefault(); setPosition(100); }
    });

    // Click anywhere on wrapper
    wrapper.addEventListener('click', function(e) {
      if (e.target === handle || handle.contains(e.target)) return;
      setPosition(getPercent(e.clientX));
    });
  }

  document.querySelectorAll('[data-ba-slider]').forEach(initSlider);
})();
</script>

{% stylesheet %}
  .before-after-slider {
    padding: 4rem 0;
  }

  .before-after-slider__subheading {
    text-align: center;
    opacity: 0.75;
    margin-top: -1.25rem;
    margin-bottom: 2rem;
    font-size: 1rem;
  }

  /* ── Wrapper ── */
  .ba-slider__wrapper {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    user-select: none;
    cursor: col-resize;
  }

  /* ── Nachher (Basis-Layer) ── */
  .ba-slider__after {
    position: absolute;
    inset: 0;
  }

  .ba-slider__after img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Vorher (vorne, beschnitten) ── */
  .ba-slider__before {
    position: absolute;
    inset: 0 auto 0 0;
    overflow: hidden;
    z-index: 1;
  }

  .ba-slider__before img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Bild nimmt immer volle Wrapper-Breite ein – width bezieht sich auf den Clip-Container */
    min-width: var(--ba-wrapper-width, 100%);
  }

  /* ── Placeholder ── */
  .ba-slider__placeholder {
    width: 100%;
    height: 100%;
    background-color: #f0ebe4;
  }

  .ba-slider__placeholder svg {
    width: 100%;
    height: 100%;
  }

  /* ── Labels ── */
  .ba-slider__label {
    position: absolute;
    bottom: 1rem;
    padding: 0.25rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-radius: 2px;
    pointer-events: none;
  }

  .ba-slider__before-label {
    right: 0.75rem;
    white-space: nowrap;
  }

  .ba-slider__after-label {
    left: 0.75rem;
  }

  /* ── Handle ── */
  .ba-slider__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: col-resize;
    outline: none;
  }

  .ba-slider__handle:focus-visible .ba-slider__handle-circle {
    box-shadow: 0 0 0 3px rgba(255,255,255,0.8);
  }

  .ba-slider__handle-line {
    flex: 1;
    width: 2px;
  }

  .ba-slider__handle-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.35);
  }

  .ba-slider__handle-icon {
    width: 22px;
    height: 22px;
    color: #ffffff;
    display: block;
  }

  @media (max-width: 768px) {
    .before-after-slider {
      padding: 3rem 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vorher-Nachher Slider",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Unterüberschrift"
    },
    {
      "type": "header",
      "content": "Bilder"
    },
    {
      "type": "image_picker",
      "id": "image_before",
      "label": "Vorher-Bild"
    },
    {
      "type": "image_picker",
      "id": "image_after",
      "label": "Nachher-Bild"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Bildformat",
      "options": [
        { "value": "landscape", "label": "Querformat (4:3)" },
        { "value": "wide", "label": "Breit (16:9)" },
        { "value": "square", "label": "Quadrat (1:1)" },
        { "value": "portrait", "label": "Hochformat (3:4)" }
      ],
      "default": "landscape"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "initial_position",
      "label": "Startposition",
      "min": 10,
      "max": 90,
      "step": 5,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "Labels anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "label_before",
      "label": "Label Vorher",
      "default": "Vorher"
    },
    {
      "type": "text",
      "id": "label_after",
      "label": "Label Nachher",
      "default": "Nachher"
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "handle_color",
      "label": "Handle-Farbe",
      "default": "#3d2314"
    },
    {
      "type": "color",
      "id": "label_bg",
      "label": "Label Hintergrund",
      "default": "#3d2314"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label Textfarbe",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Vorher-Nachher Slider",
      "category": "Bilder"
    }
  ]
}
{% endschema %}
