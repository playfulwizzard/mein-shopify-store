{%- assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0 -%}
{%- assign media_type = section.settings.media_type -%}

{% style %}
  #shopify-section-{{ section.id }} .hero {
    min-height: {{ section.settings.min_height }}px;
  }
  #shopify-section-{{ section.id }} .hero__content {
    text-align: {{ section.settings.content_alignment }};
    color: {{ section.settings.text_color }};
  }
  {%- if section.settings.content_alignment == 'center' -%}
  #shopify-section-{{ section.id }} .hero__subheading {
    margin-inline: auto;
  }
  {%- endif -%}
  #shopify-section-{{ section.id }} .hero__cta {
    background-color: {{ section.settings.text_color }};
    color: {{ section.settings.overlay_color }};
  }
{% endstyle %}

<div class="hero full-width">

  {%- comment -%} ── Hintergrundmedium ── {%- endcomment -%}
  <div class="hero__media">
    {%- if media_type == 'video' and section.settings.video != blank -%}
      {{- section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          class: 'hero__video'
      -}}

    {%- elsif media_type == 'youtube' and section.settings.video_url != blank -%}
      {%- assign yt_id = section.settings.video_url.id -%}
      <div class="hero__youtube-wrapper" aria-hidden="true">
        <iframe
          class="hero__youtube"
          src="https://www.youtube-nocookie.com/embed/{{ yt_id }}?autoplay=1&mute=1&loop=1&playlist={{ yt_id }}&controls=0&showinfo=0&rel=0&playsinline=1&enablejsapi=1"
          frameborder="0"
          allow="autoplay; encrypted-media"
          allowfullscreen
          loading="lazy"
          title="{{ section.settings.heading | escape }}"
        ></iframe>
      </div>

    {%- elsif section.settings.image != blank -%}
      {{- section.settings.image
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          class: 'hero__image',
          alt: section.settings.image.alt | default: section.settings.heading | escape
      -}}
    {%- endif -%}
  </div>

  {%- comment -%} ── Farbüberlagerung ── {%- endcomment -%}
  <div
    class="hero__overlay"
    style="background-color: {{ section.settings.overlay_color }}; opacity: {{ overlay_opacity }};"
    aria-hidden="true"
  ></div>

  {%- comment -%} ── Textinhalt ── {%- endcomment -%}
  <div class="hero__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="hero__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a class="hero__cta" href="{{ section.settings.cta_url | default: '#' }}">
        {{- section.settings.cta_label | escape -}}
      </a>
    {%- endif -%}
  </div>

</div>

{% stylesheet %}
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: var(--content-grid);
    overflow: hidden;
  }

  /* ── Hintergrundmedium ── */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__image,
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* YouTube Background */
  .hero__youtube-wrapper {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero__youtube {
    position: absolute;
    top: 50%;
    left: 50%;
    /* Mindestgröße: 16:9 → immer größer als der Container */
    width: max(100%, calc(100vh * 16 / 9));
    height: max(100%, calc(100vw * 9 / 16));
    transform: translate(-50%, -50%);
    border: 0;
  }

  /* ── Overlay ── */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* ── Textinhalt ── */
  .hero__content {
    grid-column: 2;
    position: relative;
    z-index: 2;
    padding: 5rem 0;
    width: 100%;
  }

  .hero__heading {
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .hero__subheading {
    margin-top: 1.25rem;
    font-size: clamp(1rem, 2vw, 1.35rem);
    max-width: 55ch;
    line-height: 1.6;
    opacity: 0.9;
  }

  .hero__cta {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.875rem 2.25rem;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    border-radius: var(--style-border-radius-inputs);
    transition: opacity 0.2s ease;
  }

  .hero__cta:hover {
    opacity: 0.85;
  }

  @media (max-width: 768px) {
    .hero__content {
      text-align: center;
      padding: 4rem 0;
    }

    .hero__subheading {
      margin-inline: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Hintergrundmedium"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Medientyp",
      "options": [
        { "value": "image", "label": "Bild" },
        { "value": "video", "label": "Video (hochgeladen)" },
        { "value": "youtube", "label": "YouTube" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild",
      "info": "Wird bei Medientyp \"Bild\" verwendet"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Wird bei Medientyp \"Video (hochgeladen)\" verwendet. Empfohlen: MP4, max. 10 MB, ohne Ton."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "YouTube-URL",
      "accept": ["youtube"],
      "info": "Wird bei Medientyp \"YouTube\" verwendet. Das Video wird automatisch stumm im Hintergrund abgespielt."
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Mindesthöhe",
      "min": 300,
      "max": 800,
      "step": 50,
      "default": 600,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Farbüberlagerung"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Farbe",
      "default": "#3d2314"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Transparenz",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Echte Kakao-Kultur"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Unterüberschrift",
      "default": "Handverlesene Kakaoprodukte aus nachhaltigem Anbau"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Textausrichtung",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Mitte" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button-Text",
      "default": "Jetzt entdecken"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button-Link"
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "category": "Startseite"
    }
  ]
}
{% endschema %}
